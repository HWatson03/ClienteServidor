# Copia este archivo como backend/.env y reemplaza los valores locales.
DB_URL=jdbc:postgresql://localhost:5432/bd_servidor_local
DB_USERNAME=appu
DB_PASSWORD=cambia-esta-clave
BOOTSTRAP_USUARIO=admin
BOOTSTRAP_CONTRASENA=cambia-esta-clave-inicial
